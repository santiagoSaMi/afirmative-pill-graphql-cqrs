# ─────────────────────────────────────────────────────────────
# Afirmative Pill · configuración
# Copia este archivo:  cp .env.example .env   y completa los valores.
# ─────────────────────────────────────────────────────────────

# Connection string de tu proyecto Supabase.
# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# Usa el Session pooler: la conexión directa (db.<ref>.supabase.co) suele ser solo IPv6
# y Docker en muchas redes no tiene IPv6.
# Si tu contraseña tiene caracteres especiales (@ : / # ? %), codifícalos (URL-encode).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:  openssl rand -hex 32
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres"

# ───────── Opcionales (valores por defecto entre paréntesis) ─────────
# DATABASE_SSL=true                # (true) Supabase exige SSL
# JWT_EXPIRES_IN=12h               # (12h)
# FRONTEND_ORIGIN=http://localhost:3000
# ENABLE_INTROSPECTION=true        # (true) Apollo Sandbox en http://localhost:4000/graphql
# LOG_SQL=true                     # (true) imprime cada SQL: evidencia del DataLoader
# PROJECTION_DELAY_MS=1500         # retraso artificial del proyector -> hace visible la consistencia eventual
# REVIEW_DELAY_MS=10000            # tiempo de validación farmacéutica de fórmulas médicas
# DISPATCH_DELAY_MS=15000          # tiempo entre APPROVED y DISPATCHED
